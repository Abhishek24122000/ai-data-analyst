# Copy to .env and fill in. All values also work as plain environment
# variables (e.g. when set in Render's dashboard).

# --- LLM provider: "groq" (free, recommended), "openai", "anthropic", or "none" ---
LLM_PROVIDER=groq
LLM_API_KEY=
LLM_MODEL=llama-3.3-70b-versatile
LLM_BASE_URL=https://api.groq.com/openai/v1

# --- Storage / limits ---
STORAGE_DIR=./storage
MAX_UPLOAD_MB=50
MAX_SQL_RETRIES=2
MAX_HISTORY_TURNS=6
MAX_RESULT_ROWS=500

# --- CORS: comma-separated origins, or * for dev ---
CORS_ORIGINS=*
